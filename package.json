{
  "name": "dsh-plugin-update-manager",
  "version": "0.1.7",
  "description": "DSH 插件更新管理器：在设置页检查已安装插件的版本状态，并安全地升级到最新版或与本机 DSH 兼容的版本。支持 npm 官方 / npm 国内镜像 / GitHub / GitHub 国内镜像四种更新源。",
  "keywords": [
    "compatibility",
    "dsh",
    "dsh-plugin",
    "plugin",
    "plugin-updater",
    "semver",
    "update-manager"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.4.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test --experimental-test-isolation=none test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test:isolation": "node --test test/*.test.js"
  },
  "license": "MIT",
  "bin": {
    "dsh-plugin-update-manager": "lib/cli.js"
  },
  "author": "SpaceSphere",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REX97496/dsh-plugin-update-manager.git"
  },
  "homepage": "https://github.com/REX97496/dsh-plugin-update-manager#readme",
  "bugs": {
    "url": "https://github.com/REX97496/dsh-plugin-update-manager/issues"
  }
}
